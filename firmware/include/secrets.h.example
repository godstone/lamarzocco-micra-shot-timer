// OPTIONAL developer convenience: copy to secrets.h (git-ignored) and fill in — the values
// seed the device's runtime settings (NVS) on first boot. Without this file the firmware is
// fully functional: WiFi + LM account are entered on the phone via the setup portal, the
// installation key is generated on-device, and the machine serial is auto-discovered.
#pragma once

// ── WiFi ─────────────────────────────────────────────────────────────────────
#define WIFI_SSID "your-wifi"
#define WIFI_PASSWORD "your-wifi-password"

// ── La Marzocco Home account (same login as the app) ─────────────────────────
#define LM_USERNAME "you@example.com"
#define LM_PASSWORD "your-app-password"
#define LM_SERIAL "MR0XXXXX"  // your machine serial (see pre-flight output)
#define LM_TIMEZONE "Europe/Zurich"  // your timezone (for the "shots today" trend)

// ── Installation key — copy the three values from the JSON file generated by
//    tools/preflight (tools/preflight/installation_key.json):
//      "installation_id" -> LM_INSTALLATION_ID
//      "secret"          -> LM_SECRET_B64        (base64, 32 bytes)
//      "private_key"     -> LM_PRIVATE_KEY_B64   (base64 DER, one long line)
//    The device reuses this already-registered key, so it only SIGNS requests.
#define LM_INSTALLATION_ID "00000000-0000-0000-0000-000000000000"
#define LM_SECRET_B64 "...base64 secret..."
#define LM_PRIVATE_KEY_B64 "...base64 DER private key..."
