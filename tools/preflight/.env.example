# Single source of truth for all device credentials. Copy to .env (git-ignored) and fill in.
# Used by: the Python pre-flight, and tools/gen_secrets.py (which writes firmware/include/secrets.h).

# La Marzocco Home login (same as the app)
LM_USERNAME=you@example.com
LM_PASSWORD=your-app-password

# Machine serial (optional; pre-flight auto-detects if omitted)
LM_SERIAL=MR051692

# Home WiFi for the ESP32 display
WIFI_SSID=your-wifi
WIFI_PASSWORD=your-wifi-password

# Your timezone (used for the "shots today" trend). E.g. Europe/Zurich, America/New_York.
LM_TIMEZONE=Europe/Zurich

# Optional pre-flight tuning
# POLL_INTERVAL=1.0
